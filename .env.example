# ---------------------------------------------------------------------------
# Cantina — variáveis de ambiente
# Copie para .env e ajuste. Nada aqui deve ir para o git.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP -------------------------------------------------------------------
API_PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000

# Domínio raiz das vitrines. Em dev, *.localhost resolve sem mexer no hosts
# na maioria dos navegadores: padaria.cantina.localhost:3000
ROOT_DOMAIN=cantina.localhost

# --- Banco ------------------------------------------------------------------
# Conexão da aplicação: papel cantina_app, SUJEITO a RLS.
# 100% das rotas de tenant usam esta.
DATABASE_URL=postgresql://cantina_app:cantina@localhost:5432/cantina

# Conexão administrativa: papel com BYPASSRLS.
# Usada só por migrations e pelo módulo `platform`.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/cantina

DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-segredo-em-producao-access
JWT_REFRESH_SECRET=troque-este-segredo-em-producao-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Assinatura (Asaas) -----------------------------------------------------
# Sem ASAAS_API_KEY a API usa um adaptador LOCAL: a assinatura é ativada sem
# cobrança nenhuma, o que deixa o fluxo testável sem conta em provedor.
# Em producao a API SE RECUSA A SUBIR sem a chave — de propósito: continuar
# "ativando" assinaturas sem cobrar seria dar o produto de graça em silêncio.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token estático que o Asaas envia no header `asaas-access-token`. Sem ele o
# webhook recusa TODA requisição — é a única autenticação daquela rota.
ASAAS_WEBHOOK_TOKEN=

# --- E-mail transacional (Resend) -------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Cantina <nao-responda@cantina.app>

# --- Storage de imagens (S3-compatível) -------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cantina
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/cantina
