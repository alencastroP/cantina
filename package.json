{
  "name": "cantina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @cantina/api",
    "dev:web": "npm run dev -w @cantina/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run generate -w @cantina/db",
    "db:migrate": "npm run migrate -w @cantina/db",
    "db:rls": "npm run rls -w @cantina/db",
    "db:setup": "npm run setup -w @cantina/db",
    "db:seed": "npm run seed -w @cantina/api",
    "db:studio": "npm run studio -w @cantina/db",
    "verify:rls": "npm run verify:rls -w @cantina/api",
    "smoke": "npm run smoke -w @cantina/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
