{
  "name": "@cantina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=../../.env scripts/seed.ts",
    "verify:rls": "tsx --env-file=../../.env scripts/verify-rls.ts",
    "test": "tsx --test src/app.test.ts src/shared/slug.test.ts src/modules/inventory/stock.test.ts src/modules/storefront/storefront.test.ts src/modules/finance/finance.test.ts src/modules/reports/reports.test.ts src/modules/billing/billing.test.ts src/modules/signup/signup.test.ts src/integrations/whatsapp.test.ts src/integrations/storage.test.ts src/http/middlewares/cost-visibility.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@cantina/contracts": "*",
    "@cantina/db": "*",
    "@cantina/domain": "*",
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
