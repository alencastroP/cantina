{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tem que bater com o nome do projeto no dashboard Cloudflare ("cantina",
  // criado quando o repo foi conectado). O CI do Workers Builds força esse
  // nome na hora de publicar, ignorando o que estiver aqui — mas o binding
  // WORKER_SELF_REFERENCE abaixo usa este campo pra saber em quem apontar,
  // então os dois precisam concordar.
  "name": "cantina",
  "main": ".open-next/worker.js",
  // Compatibilidade mínima exigida pelo adaptador (nodejs_compat + fetch
  // restrito a rotas públicas). Atualize a data periodicamente — não precisa
  // ser hoje, só recente.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Usado pelo OpenNext para chamadas internas (ex.: revalidação) sem sair
  // para a rede pública.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cantina" }],

  // Custom Domain criado no painel (Settings → Domains & Routes). Declarado
  // aqui de propósito: sem isto, `wrangler deploy` via CLI ou via Workers
  // Builds enxerga a rota remota como "config que não bate com a local" e a
  // apaga no próximo deploy, derrubando appcantina.com.br sem aviso.
  "routes": [{ "pattern": "appcantina.com.br", "custom_domain": true }],

  // Variáveis públicas, versionadas aqui de propósito: `wrangler deploy`
  // SOBRESCREVE as vars do Worker com o que estiver neste arquivo, então o que
  // só existe no painel do Cloudflare some no primeiro deploy feito pela CLI.
  // Segredo não entra aqui (vai por `wrangler secret put`); estas são públicas
  // por definição, já que `NEXT_PUBLIC_*` vai embutido no bundle.
  //
  // Elas também precisam existir como variáveis de BUILD no painel: o Next
  // embute `NEXT_PUBLIC_*` na hora do build, não em runtime, e é a esteira do
  // Workers Builds que roda esse build.
  //
  // ROOT_DOMAIN é o host que o middleware trata como domínio raiz (landing e
  // painel). Qualquer host que não bata com isso (ou com "www." + isso) é
  // tratado como vitrine de loja — por isso precisa ser o domínio próprio.
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_API_URL": "https://appcantina-api.onrender.com",
    "NEXT_PUBLIC_ROOT_DOMAIN": "appcantina.com.br"
  },

  "observability": { "enabled": true }
}
